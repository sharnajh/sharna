"C:\Program Files\nodejs\node.exe" -e "const http=require('http');const fs=require('fs');const path=require('path');const root=path.join(process.cwd(),'build');const mime={'.html':'text/html; charset=utf-8','.js':'application/javascript; charset=utf-8','.css':'text/css; charset=utf-8','.json':'application/json; charset=utf-8','.png':'image/png','.jpg':'image/jpeg','.jpeg':'image/jpeg','.svg':'image/svg+xml','.ico':'image/x-icon','.txt':'text/plain; charset=utf-8','.pdf':'application/pdf'};http.createServer((req,res)=>{const cleanUrl=(req.url||'/').split('?')[0];const relPath=cleanUrl==='/'?'/index.html':cleanUrl;let filePath=path.join(root,relPath.replace(/^\//,''));if(!filePath.startsWith(root)){res.writeHead(403);return res.end('Forbidden');}const sendFile=(target)=>fs.readFile(target,(err,data)=>{if(err){res.writeHead(404);return res.end('Not found');}res.writeHead(200,{'Content-Type':mime[path.extname(target).toLowerCase()]||'application/octet-stream'});res.end(data);});fs.stat(filePath,(err,stat)=>{if(!err&&stat.isDirectory())filePath=path.join(filePath,'index.html');fs.access(filePath,fs.constants.F_OK,(accessErr)=>accessErr?sendFile(path.join(root,'index.html')):sendFile(filePath));});}).listen(4173,'127.0.0.1');"
